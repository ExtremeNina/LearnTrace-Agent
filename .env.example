# ============================================
# LearnTrace 一键部署环境变量（复制为 .env 后填写）
#   cp .env.example .env
# 说明：.env 已被 git 忽略，切勿提交真实密钥
# ============================================

# ---- 基础 ----
# 对外访问端口（http://localhost:8080）
WEB_PORT=8080
DB_NAME=xueji
# MySQL root 密码（首次创建数据卷时生效，之后改这里不会同步已有库）
DB_PASSWORD=change-me-please
RABBITMQ_USER=xueji
RABBITMQ_PASS=change-me-please

# ---- LLM（必填，否则对话/笔记/简报不可用）----
DEEPSEEK_API_KEY=

# ---- 语音转写（阿里云百炼 Qwen-Audio ASR）----
QWEN_ASR_API_KEY=
QWEN_ASR_BASE_URL=https://ws-swm6f3vt0izc1plg.cn-beijing.maas.aliyuncs.com
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash

# ---- OCR（百度 PaddleOCR AI Studio）----
PADDLE_OCR_TOKEN=
PADDLE_OCR_BASE=https://paddleocr.aistudio-app.com/api/v2/ocr
PADDLE_OCR_MODEL=PaddleOCR-VL-1.6

# ---- 阿里云 OSS（视频/图片存储）----
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_DOMAIN=

# ---- RAG 向量化（百炼 text-embedding-v3）----
XJ_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
XJ_EMBEDDING_API_KEY=
XJ_EMBEDDING_MODEL=text-embedding-v3

# ---- 其他（留空即默认）----
# 浏览器 cookies 登录态（容器内通常不可用，留空走游客模式；课程类视频建议用 cookies.txt）
YTDLP_COOKIES_FROM_BROWSER=
# 同源部署无需跨域；如前端分离部署可填，如 http://192.168.1.10:8080
CORS_ALLOWED_ORIGINS=
